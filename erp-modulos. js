async function crud(m,el){
 const rows=await api.list(m.c),ref={};
 for(const f of m.f)if(f[2]=='r')ref[f[0]]=(await(f[3]=='catalogo_platos'?rd(f[3]):api.list(f[3]))).map(x=>f[3]=='catalogo_platos'?pn(x):(x.nombre||x.id));
 const inp=f=>{const id='e_'+f[0],l=f[1].replace('?','');let i;
  if(f[2]=='s'||f[2]=='r'){const o=f[2]=='s'?f[3]:ref[f[0]];i=`<select id="${id}">${f[1].endsWith('?')?'<option value="">—</option>':''}${o.map(x=>`<option>${esc(x)}</option>`).join('')}</select>`}
  else i=`<input id="${id}" type="${f[2]=='n'?'number':f[2]=='d'?'date':'text'}" ${f[2]=='n'?'step="0.01"':''} value="${f[2]=='d'?today():''}">`;
  return`<div><label>${l}</label>${i}</div>`};
 const cols=[...m.f.map(f=>f[0]),...(m.x||[])],lab=k=>(m.f.find(f=>f[0]==k)||[0,k[0].toUpperCase()+k.slice(1)])[1].replace('?','');
 const mk=new Set(['costo','total','monto','sueldo','precio']);
 el.innerHTML=`<div class="card"><strong style="color:var(--gold)" id="erpFt">Nuevo registro</strong><div class="erp-f" style="margin-top:8px">${m.f.map(inp).join('')}</div><div style="display:flex;gap:8px;margin-top:12px"><button class="btn btn-save" onclick="ERP.sv()"><i class="fa-solid fa-floppy-disk"></i> Guardar</button><button class="btn btn-del" onclick="ERP.go('${cur}')">Cancelar</button></div></div>
 <div class="card" style="overflow:auto"><strong>Registros (${rows.length})</strong>${tbl([...cols.map(lab),'Acciones'].map(String),[]).replace(/<tbody>.*<\/tbody>/,'<tbody>'+(rows.length?rows.map(r=>`<tr>${cols.map(k=>`<td>${esc(mk.has(k)?money(r[k]):r[k])}</td>`).join('')}<td style="white-space:nowrap"><button class="btn btn-save" style="padding:4px 8px" onclick="ERP.ed('${r.id}')">Editar</button> <button class="btn btn-del" style="padding:4px 8px" onclick="ERP.dl('${r.id}')">✕</button></td></tr>`).join(''):`<tr><td colspan="${cols.length+1}" style="text-align:center">Sin registros.</td></tr>`)+'</tbody>')}</div>`;
 last=rows}
async function sv(){const m=M[cur],o={};
 for(const f of m.f){const v=$('#e_'+f[0]).value.trim();if(v===''&&!f[1].endsWith('?'))return alert('Completa: '+f[1]);o[f[0]]=f[2]=='n'?+v:v}
 if(m.pre){const e=await m.pre(o);if(e)return alert('⛔ '+e)}
 const id=edit||Date.now().toString(36);
 if(edit&&m.hd)await m.hd(id);
 await api.put(m.c,id,o);if(m.h)await m.h(o,id);edit=null;draw()}
function ed(id){const r=last.find(x=>x.id==id),m=M[cur];edit=id;m.f.forEach(f=>$('#e_'+f[0]).value=r[f[0]]??'');$('#erpFt').textContent='Editando registro';scrollTo({top:0,behavior:'smooth'});sec.scrollIntoView()}
async function dl(id){if(!confirm('¿Eliminar registro?'))return;const m=M[cur];await api.del(m.c,id);if(m.hd)await m.hd(id);draw()}

async function rep(m,el){const d=await load(),o=R[cur](d);last=o;
 el.innerHTML=`<div class="card"><div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end"><div><label>Desde</label><input type="date" id="erpD" value="${F.d}"></div><div><label>Hasta</label><input type="date" id="erpH" value="${F.h}"></div><button class="btn btn-save" onclick="ERP.ap()">Aplicar</button><button class="btn btn-add" onclick="ERP.csv()"><i class="fa-solid fa-file-csv"></i> CSV</button><button class="btn btn-print" onclick="window.print()"><i class="fa-solid fa-print"></i></button></div></div><div class="card" style="overflow:auto">${tbl(o.h,o.r)}</div>`}
const ap=()=>{F.d=$('#erpD').value;F.h=$('#erpH').value;draw()};
const csv=()=>{const t=[last.h,...last.r].map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+t],{type:'text/csv'}));a.download=cur+'_'+today()+'.csv';a.click()};

async function cierre(m,el){const f=window._cf||today(),[v,ca,cmv,cs]=await Promise.all([rd('ventas'),api.list('caja_monto_inicial'),api.list('caja_movs'),api.list('cierres')]);
 const V=v.filter(x=>iso(x.fecha)==f),mi=sum(ca.filter(x=>x.fecha==f),x=>x.monto),C=cmv.filter(x=>x.fecha==f),ef=sum(V.filter(x=>(x.pago||'Efectivo')=='Efectivo'),x=>x.totalPEN),oth=sum(V,x=>x.totalPEN)-ef,ing=sum(C.filter(x=>x.tipo!='Salida'),x=>x.monto),sal=sum(C.filter(x=>x.tipo=='Salida'),x=>x.monto),esp=mi+ef+ing-sal;
 window._cr={id:f,fecha:f,montoInicial:mi,ventasEfectivo:ef,ventasOtros:oth,ingresos:ing,salidas:sal,efectivoEsperado:esp,total:sum(V,x=>x.totalPEN),comprobantes:V.length};
 el.innerHTML=`<div class="card"><label>Fecha de cierre</label><input type="date" id="erpCf" value="${f}" onchange="window._cf=this.value;ERP.rf()">${tbl(['Concepto','Monto'],[['Monto inicial',money(mi)],['Ventas en efectivo',money(ef)],['Ventas Yape/Plin/Tarjeta/Otros',money(oth)],['Otros ingresos',money(ing)],['Salidas',money(-sal)],['EFECTIVO ESPERADO EN CAJA',money(esp)],['Venta total del día ('+V.length+' comprobantes)',money(sum(V,x=>x.totalPEN))]])}<button class="btn btn-save" style="margin-top:12px" onclick="ERP.cs()"><i class="fa-solid fa-lock"></i> Registrar cierre del día</button></div><div class="card" style="overflow:auto"><strong>Cierres registrados</strong>${tbl(['Fecha','Inicial','Efectivo','Otros medios','Esperado','Total día'],cs.sort((a,b)=>a.id<b.id?1:-1).map(c=>[c.fecha,money(c.montoInicial),money(c.ventasEfectivo),money(c.ventasOtros),money(c.efectivoEsperado),money(c.total)]))}</div>`}
const cs=async()=>{await api.put('cierres',window._cr.id,{...window._cr,operador:sessionStorage.getItem('nombre_operador')||''});alert('✔ Cierre registrado.');draw()};
function ayuda(m,el){el.innerHTML='<div class="card" style="line-height:1.6;font-size:13px"><b>Flujo contable-administrativo</b><br>1) Configura <b>Unidades, Tipos de Insumo, Almacenes, Proveedores e Insumos</b>.<br>2) Registra <b>Compras</b> y <b>Guías de Ingreso</b> (suben stock) o <b>Guías de Salida</b> (bajan stock; bloquea si no hay saldo). <b>Transferencias</b> mueven stock entre almacenes.<br>3) Define <b>Recetas</b> por plato: así se calcula el costo y margen en <b>Rendimiento de Platos</b> y el consumo teórico de insumos.<br>4) Las <b>Facturas personalizadas</b> y <b>Notas de crédito/débito</b> se registran también en ventas (la nota de crédito resta).<br>5) En <b>Caja</b> registra monto inicial y movimientos, y haz el <b>Cierre Diario</b>.<br>6) Todos los reportes tienen filtro de fechas, CSV e impresión.</div>'}

window.ERP={go,sv,ed,dl,ap,csv,cs,rf:draw};
})();
